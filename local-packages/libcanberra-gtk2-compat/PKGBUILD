# GTK 2 compatibility bindings; keep the distribution's core/GTK 3 library.
pkgname=libcanberra-gtk2-compat
pkgver=0.30
pkgrel=2
pkgdesc='GTK 2 event-sound bindings using the installed libcanberra backend'
arch=('x86_64')
url='https://0pointer.net/lennart/projects/libcanberra/'
license=('LGPL-2.1-or-later')
depends=('gtk2' 'libcanberra.so=0-64')
makedepends=('gcc' 'make' 'pkgconf' 'libtool')
provides=('libcanberra-gtk2' 'libcanberra-gtk.so=0-64')
conflicts=('libcanberra-gtk2')
options=('!debug' '!lto')
source=("https://0pointer.net/lennart/projects/libcanberra/libcanberra-$pkgver.tar.xz")
sha256sums=('c2b671e67e0c288a69fc33dc1b6f1b534d07882c2aceed37004bf48c601afa72')

build() {
  cd "libcanberra-$pkgver"
  export CFLAGS="$CFLAGS -std=gnu17 -Wno-error=implicit-function-declaration"
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
    --disable-static --enable-gtk --disable-gtk3 \
    --disable-alsa --disable-oss --disable-pulse --disable-udev \
    --disable-gstreamer --disable-tdb --disable-lynx --disable-gtk-doc
  # Link the two GTK 2 units directly against the installed core. Do not build
  # or relink a replacement core library through the legacy libtool rules.
  gcc $CFLAGS -fPIC -DHAVE_CONFIG_H -I. -Isrc \
    $(pkg-config --cflags gtk+-2.0 libcanberra) -shared \
    -Wl,-soname,libcanberra-gtk.so.0 -Wl,-z,defs \
    -o libcanberra-gtk.so.0.1.9 src/canberra-gtk.c \
    $LDFLAGS $(pkg-config --libs gtk+-2.0 libcanberra x11)
  ln -sf libcanberra-gtk.so.0.1.9 libcanberra-gtk.so
  gcc $CFLAGS -fPIC -DHAVE_CONFIG_H -I. -Isrc \
    $(pkg-config --cflags gtk+-2.0 libcanberra) -shared -Wl,-z,defs \
    -o libcanberra-gtk-module.so src/canberra-gtk-module.c \
    -L. -lcanberra-gtk $LDFLAGS $(pkg-config --libs gtk+-2.0 libcanberra x11 gmodule-2.0)
}

package() {
  cd "libcanberra-$pkgver"
  install -Dm755 libcanberra-gtk.so.0.1.9 "$pkgdir/usr/lib/libcanberra-gtk.so.0.1.9"
  ln -s libcanberra-gtk.so.0.1.9 "$pkgdir/usr/lib/libcanberra-gtk.so.0"
  ln -s libcanberra-gtk.so.0 "$pkgdir/usr/lib/libcanberra-gtk.so"
  install -Dm755 libcanberra-gtk-module.so "$pkgdir/usr/lib/gtk-2.0/modules/libcanberra-gtk-module.so"
  install -Dm644 libcanberra-gtk.pc "$pkgdir/usr/lib/pkgconfig/libcanberra-gtk.pc"
}
