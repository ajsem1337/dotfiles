--- a/fzf/fzf.fish
+++ b/fzf/fzf.fish
@@ -18,5 +18,5 @@
-if set -q FZF_DEFAULT_OPTS[1]; and test -n "$FZF_DEFAULT_OPTS"
-    set -Ux FZF_DEFAULT_OPTS "$FZF_DEFAULT_OPTS
-$fzf_theme_opts"
-else
-    set -Ux FZF_DEFAULT_OPTS "$fzf_theme_opts"
+# Keep unrelated options, but replace our previous colors on reload or in a child shell.
+# Global/exported values avoid accumulating copies in Fish's universal variables.
+set -l fzf_base_opts "$FZF_DEFAULT_OPTS"
+if set -q NOCTALIA_FZF_THEME_OPTS[1]; and test -n "$NOCTALIA_FZF_THEME_OPTS"
+    set fzf_base_opts (string replace -- "$NOCTALIA_FZF_THEME_OPTS" "" "$fzf_base_opts" | string collect)
@@ -23,0 +24,2 @@
+set -gx NOCTALIA_FZF_THEME_OPTS "$fzf_theme_opts"
+set -gx FZF_DEFAULT_OPTS "$(string trim -- "$fzf_base_opts") $fzf_theme_opts"
--- a/papirus-icons/apply.sh
