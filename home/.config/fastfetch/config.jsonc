{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

	"logo": {
		"type": "kitty",
		"source": "~/.config/fastfetch/images/be1d371581e3ac7761a8ec99370f174e.jpg",
		"height": 14,
		"padding": { "right": 2 }
	},

	"display": {
		"separator": "    ",
		"key": { "type": "string", "paddingLeft": 0 }
	},
	"modules": [
		// ⟪ System ⟫
		{ "type": "kernel", "key": "┌  Kernel", "keyColor": "#f5c2e7" },
		{
			"type": "bootmgr",
			"key": "├  BootMgr",
			"keyColor": "#f5c2e7",
			"format": "{1}"
		},
		{ "type": "initsystem", "key": "├  Init", "keyColor": "#f5c2e7" },
		{ "type": "shell", "key": "├  Shell", "keyColor": "#f5c2e7" },
		{ "type": "packages", "key": "├ 󰏖 Packages", "keyColor": "#f5c2e7" },
		{ "type": "uptime", "key": "├  Uptime", "keyColor": "#f5c2e7" },
		{
			"type": "command",
			// Installation date from Calamares/pacman: 2026-08-22T20:30:29+02:00
			"key": "└  OS Age",
			"keyColor": "#f5c2e7",
			"text": "b=@INSTALL_EPOCH@; n=$(date +%s); d=$(( (n-b)/86400 )); echo ${d} days"
		},

		// ⟪ DE / WM ⟫
		"break",
		{ "type": "de", "key": "┌  DE", "keyColor": "#89b4fa" },
		{ "type": "wm", "key": "├  WM", "keyColor": "#89b4fa" },
		{ "type": "theme", "key": "├ 󰉼 Theme", "keyColor": "#89b4fa" },
		{ "type": "icons", "key": "├ 󰀻 Icons", "keyColor": "#89b4fa" },
		{ "type": "terminal", "key": "├  Terminal", "keyColor": "#89b4fa" },
		{
			"type": "terminalfont",
			"key": "└  TermFont",
			"keyColor": "#89b4fa",
			"format": "{2}"
		}
	]
}
