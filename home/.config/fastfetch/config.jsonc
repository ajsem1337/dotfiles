{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "kitty",
		"source": "~/.config/fastfetch/images/be1d371581e3ac7761a8ec99370f174e.jpg",
		"height": 14,
		"padding": { "right": 2 }
	},
	"display": {
		"separator": "    ",
		"key": { "type": "string", "paddingLeft": 0 }
	},
	"modules": [
		{ "type": "kernel", "key": "┌  Kernel" },
		{ "type": "bootmgr", "key": "├  BootMgr", "format": "{1}" },
		{ "type": "initsystem", "key": "├  Init" },
		{ "type": "shell", "key": "├  Shell" },
		{ "type": "packages", "key": "├ 󰏖 Packages" },
		{ "type": "uptime", "key": "├  Uptime" },
		{
			"type": "command",
			"key": "└  OS Age",
			"text": "b=1787423429; n=$(date +%s); d=$(( (n-b)/86400 )); echo ${d} days"
		},
		"break",
		{ "type": "wm", "key": "┌  WM" },
		{ "type": "theme", "key": "├ 󰉼 Theme" },
		{ "type": "icons", "key": "├ 󰀻 Icons" },
		{ "type": "terminal", "key": "├  Terminal" },
		{ "type": "terminalfont", "key": "└  TermFont", "format": "{2}" }
	]
}
