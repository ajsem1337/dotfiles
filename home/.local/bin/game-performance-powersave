#!/usr/bin/env bash
# Keep CachyOS performance holds, then return to the preferred desktop profile.
/usr/bin/game-performance "$@"
game_status=$?

# Do not cancel another game's or application's active profile hold.
if holds=$(/usr/bin/powerprofilesctl list-holds); then
    if [[ -z "$holds" ]]; then
        /usr/bin/powerprofilesctl set power-saver ||
            printf '%s\n' 'Could not restore the power-saver profile.' >&2
    fi
fi

exit "$game_status"
